# 将本文件复制或重命名为 credentials.env 后使用。
# 推荐位置：受访问控制的本机密钥目录（不纳入 Git）。
# 每个 REPLACE_WITH... 占位符都必须由本机自行填写；真实值绝不能提交到 GitHub。

HERMES_API_KEY=***

HOST_192_168_48_61_USERNAME=REPLACE_WITH_TEST_HOST_USERNAME
HOST_192_168_48_61_PASSWORD=***
HOST_192_168_90_8_USERNAME=REPLACE_WITH_TEST_HOST_USERNAME
HOST_192_168_90_8_PASSWORD=***

JENKINS_57_USERNAME=REPLACE_WITH_JENKINS_USERNAME
JENKINS_57_PASSWORD=***

OCEANBASE_MAIN_JDBC_URL=REPLACE_WITH_JDBC_URL
OCEANBASE_MAIN_USERNAME=REPLACE_WITH_DATABASE_USERNAME
OCEANBASE_MAIN_PASSWORD=***

REPO_COMMON_USERNAME=REPLACE_WITH_REPOSITORY_USERNAME
REPO_COMMON_PASSWORD=***
